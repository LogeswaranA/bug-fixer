{
  "mcpServers": {
    "gortex": {
      "command": "gortex",
      "args": ["mcp", "--index", ".", "--watch"],
      "env": {
        "GORTEX_LOG": "info"
      }
    },
    "jira": {
      "command": "uvx",
      "args": [
        "mcp-atlassian",
        "--jira-url", "https://neogov.jira.com/"
      ],
      "env": {
        "JIRA_USERNAME": "${JIRA_USERNAME}",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}"
      }
    }
  }
}
