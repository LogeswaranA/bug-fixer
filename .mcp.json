{
  "mcpServers": {
    "gitnexus": {
      "command": "npx",
      "args": ["-y", "gitnexus@latest", "mcp"]
    },
    "jira": {
      "command": "uvx",
      "args": [
        "mcp-atlassian",
        "--jira-url", "https://neogov.jira.com/"
      ],
      "env": {
        "JIRA_URL": "https://neogov.atlassian.net",
        "JIRA_USERNAME": "your.email@neogov.com",
        "JIRA_API_TOKEN": "your_actual_api_token_here"
      }
    }
  }
}
